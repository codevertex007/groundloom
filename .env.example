GROUNDLOOM_ENV=development
GROUNDLOOM_DATABASE_URL=sqlite:///./backend/data/groundloom.db
GROUNDLOOM_CHECKPOINT_BACKEND=local
GROUNDLOOM_OBJECT_STORE_PATH=./backend/data/objects
GROUNDLOOM_OBJECT_STORE_BACKEND=local
GROUNDLOOM_OBJECT_STORE_BUCKET=
GROUNDLOOM_OBJECT_STORE_ENDPOINT=
GROUNDLOOM_OBJECT_STORE_REGION=us-east-1
GROUNDLOOM_OBJECT_STORE_ACCESS_KEY=
GROUNDLOOM_OBJECT_STORE_SECRET_KEY=
GROUNDLOOM_PUBLIC_BASE_URL=http://localhost:8000
GROUNDLOOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
GROUNDLOOM_LOCAL_USER_ID=local-user
GROUNDLOOM_LOCAL_WORKSPACE_ID=local-workspace
GROUNDLOOM_LOCAL_USER_EMAIL=author@local.test
GROUNDLOOM_LOCAL_WORKSPACE_NAME=Local Workspace
GROUNDLOOM_MODEL_PROVIDER=local
GROUNDLOOM_MODEL_NAME=deterministic-local
GROUNDLOOM_AGENT_MAX_ATTEMPTS=3
GROUNDLOOM_AGENT_RETRY_BACKOFF_SECONDS=0.25
GROUNDLOOM_TELEMETRY_PROVIDER=local
GROUNDLOOM_LANGFUSE_PUBLIC_KEY=
GROUNDLOOM_LANGFUSE_SECRET_KEY=
GROUNDLOOM_LANGFUSE_HOST=https://cloud.langfuse.com
GROUNDLOOM_MAX_UPLOAD_BYTES=25000000
GROUNDLOOM_EVENT_RETENTION_DAYS=90
GROUNDLOOM_AUTH_SECRET=
GROUNDLOOM_AUTH_MODE=local
